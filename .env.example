# Template. Copy to .env (gitignored) and fill in. Do not put real keys in this file.
# Loaded automatically by smem-eval / smem-extract / smem-demo. Shell exports win over this file.

# OpenAI, direct (api.openai.com). The judge (gpt-4o, the official LongMemEval judge) in EVERY
# config reads this, and so does gpt-4.1-mini answering in configs/default.yaml.
OPENAI_API_KEY=

# Anthropic, direct, official SDK. claude-sonnet-5 answering in configs/claude.yaml.
# Alternative to a key: `ant auth login` stores a profile the SDK reads automatically.
ANTHROPIC_API_KEY=

# TokenRouter gateway (api.tokenrouter.com). ONLY answering in configs/tokenrouter.yaml reads this
# (z-ai/glm-5.3-free); the judge there still goes direct to OpenAI with the key above. Kept in its
# own variable so a gateway key is never sent to api.openai.com.
TOKENROUTER_API_KEY=

# Optional. Only if a model repo you use is gated; bge-m3, the NLI model and Qwen3-8B-AWQ are public.
HF_TOKEN=

# Template. Copy to .env (gitignored) and fill in. Do not put real keys in this file.
# Loaded automatically by smem-eval / smem-extract / smem-demo.
# Anything already exported in the shell wins over this file.

# ---------------------------------------------------------------------------
# THE ONLY LINE YOU NEED when going through TokenRouter: paste that key below.
# ---------------------------------------------------------------------------
# The variable is named OPENAI_API_KEY because it is read by the OpenAI-compatible
# client, not because the request goes to OpenAI. TokenRouter speaks the OpenAI
# wire format, and configs/tokenrouter.yaml points base_url at
# https://api.tokenrouter.com/v1 -- so this one key covers both answering and
# judging, and nothing is ever sent to api.openai.com.
# Put a real OpenAI key here instead only if you drop the gateway (configs/default.yaml).
OPENAI_API_KEY=

# Only for talking to Anthropic DIRECTLY (configs/claude.yaml, Anthropic SDK).
# Going through TokenRouter? Leave this empty -- Claude models are reached with the
# key above, over the OpenAI wire format.
ANTHROPIC_API_KEY=

# Optional. Only needed if a model repo you use is gated. bge-m3, the NLI
# cross-encoder and Qwen3-8B-AWQ are all public, so this can stay empty.
HF_TOKEN=

# Optional: send HuggingFace/torch caches somewhere with room (models are a few GB).
# HF_HOME=/home/wangyidan451/.cache/huggingface
